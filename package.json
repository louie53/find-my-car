{
  "name": "find-my-car",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:android": "expo export --platform android",
    "check:android-config": "node scripts/check-android-config.mjs",
    "review:manifest": "node scripts/create-review-manifest.mjs",
    "build:preview": "npx eas-cli@24.8.0 build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
